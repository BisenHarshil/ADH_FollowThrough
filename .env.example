# REQUIRED in production: a long random string used to sign login sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Optional: store accounts and captures in Supabase. Without these, accounts are
# stored in a local SQLite file (users.db), which is fine locally but resets on redeploys.
SUPABASE_URL=
SUPABASE_KEY=

# Runtime
PORT=3000
FLASK_DEBUG=0

# REQUIRED in production: a long random string used to sign login sessions.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Recommended: store accounts and captures in Supabase. Without these, accounts are
# stored in a local SQLite file (users.db), which is fine locally but resets on Render redeploys.
SUPABASE_URL=
SUPABASE_KEY=

# Optional AI extraction. Without this, simple rules run offline.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=

PORT=3000
FLASK_DEBUG=0
